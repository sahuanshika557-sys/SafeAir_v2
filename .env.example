# GEMINI_API_KEY: Required server-side key for Gemini AI API calls.
# Configure this in AI Studio Secrets or Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Override the primary Gemini model.
# Default fallback list when unset: gemini-3.5-flash-lite -> gemini-3.8-flash -> gemini-3.6-flash
# If GEMINI_MODEL is set, it is tried first before the ordered fallback list.
# GEMINI_MODEL="gemini-3.5-flash-lite"
# GEMINI_FALLBACK_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
